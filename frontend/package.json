{
    "name": "clawscribe",
    "version": "0.5.35",
    "private": true,
    "scripts": {
        "dev": "next dev -p 3118",
        "build": "next build",
        "start": "next start -p 3118",
        "tauri": "tauri",
        "tauri:dev": "node scripts/tauri-auto.js dev",
        "tauri:build": "node scripts/tauri-auto.js build",
        "tauri:dev:cpu": "tauri dev",
        "tauri:dev:cuda": "tauri dev -- --features cuda",
        "tauri:dev:vulkan": "tauri dev -- --features vulkan",
        "tauri:dev:directml": "tauri dev -- --features directml",
        "tauri:dev:windows-gpu": "tauri dev -- --features windows-gpu",
        "tauri:dev:metal": "tauri dev -- --features metal",
        "tauri:dev:coreml": "tauri dev -- --features coreml",
        "tauri:dev:openblas": "tauri dev -- --features openblas",
        "tauri:dev:hipblas": "tauri dev -- --features hipblas",
        "tauri:build:cpu": "tauri build",
        "tauri:build:cuda": "tauri build -- --features cuda",
        "tauri:build:vulkan": "tauri build -- --features vulkan",
        "tauri:build:directml": "tauri build -- --features directml",
        "tauri:build:windows-gpu": "tauri build -- --features windows-gpu",
        "tauri:build:metal": "tauri build -- --features metal",
        "tauri:build:coreml": "tauri build -- --features coreml",
        "tauri:build:openblas": "tauri build -- --features openblas",
        "tauri:build:hipblas": "tauri build -- --features hipblas",
        "release:windows": "powershell -ExecutionPolicy Bypass -File scripts/build-windows-release.ps1",
        "release:windows:cpu": "powershell -ExecutionPolicy Bypass -File scripts/build-windows-release.ps1 -Feature cpu",
        "release:windows:gpu": "powershell -ExecutionPolicy Bypass -File scripts/build-windows-release.ps1 -Feature windows-gpu",
        "verify:public-repo": "node ../scripts/verify-public-repo-safety.mjs",
        "verify:icons": "powershell -ExecutionPolicy Bypass -File scripts/verify-brand-icons.ps1",
        "lint": "next lint",
        "test": "node --test tests/lib/audio-device-preferences.test.mjs tests/lib/blocknote-markdown.test.mjs tests/lib/cloud-transcription.test.mjs tests/lib/onboarding-summary-model.test.mjs tests/lib/summary-language-preferences.test.mjs",
        "test:cloud-live": "cargo test --manifest-path src-tauri/Cargo.toml --lib audio::transcription::cloud::live_smoke::hosted_api_transcription_live_smoke -- --ignored --nocapture --test-threads=1",
        "typecheck": "tsc --noEmit"
    },
